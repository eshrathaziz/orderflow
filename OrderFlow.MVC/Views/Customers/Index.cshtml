@model IEnumerable<OrderFlow.MVC.Models.Customer>
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Customers"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer management</div><h1 class="of-mvc-title">Customer relationships</h1><p class="of-mvc-subtitle">Profile, contact details, account status and order history held in one operational record.</p></div><a class="of-mvc-btn" href="@Url.Action("Create")">Add customer</a></div>
<section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Customer directory</h2><p>@ViewBag.Total accounts found.</p></div><div class="of-mvc-mono text-primary">Sorted by company</div></div><form class="of-mvc-toolbar" method="get"><input class="form-control" name="search" value="@Request["search"]" placeholder="Company, contact or email"/><select class="form-select" name="status"><option value="">All statuses</option>@foreach(CustomerStatus value in Enum.GetValues(typeof(CustomerStatus))){<option value="@value">@value</option>}</select><button class="of-mvc-btn ghost" type="submit">Apply filters</button></form><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Company</th><th>Primary contact</th><th>Location</th><th>Status</th><th>Joined</th><th></th></tr></thead><tbody>@foreach(var customer in Model){<tr><td class="of-mvc-primary"><a href="@Url.Action("Details",new{id=customer.CustomerId})">@customer.CompanyName</a></td><td><div>@customer.ContactName</div><div class="small text-muted mt-1">@customer.Email</div></td><td>@customer.City, @customer.StateOrRegion</td><td><span class="of-mvc-status @customer.Status">@customer.Status</span></td><td class="of-mvc-mono">@customer.CreatedAtUtc.ToString("dd MMM yyyy")</td><td><a class="of-mvc-btn ghost" href="@Url.Action("Details",new{id=customer.CustomerId})">Open</a></td></tr>}</tbody></table></div></section>
