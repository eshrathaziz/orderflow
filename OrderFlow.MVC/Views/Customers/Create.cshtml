@model OrderFlow.MVC.Models.Customer
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Add customer"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer management</div><h1 class="of-mvc-title">Create a customer profile.</h1><p class="of-mvc-subtitle">Capture the account, contact and delivery context used for orders and customer requests.</p></div><a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to directory</a></div>
@using(Html.BeginForm("Create","Customers",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new{@class="text-danger small"})<div class="row g-3"><div class="col-md-7"><label>Company name</label>@Html.TextBoxFor(m=>m.CompanyName,new{@class="form-control"})</div><div class="col-md-5"><label>Account status</label>@Html.EnumDropDownListFor(m=>m.Status,new{@class="form-select"})</div><div class="col-md-6"><label>Primary contact</label>@Html.TextBoxFor(m=>m.ContactName,new{@class="form-control"})</div><div class="col-md-6"><label>Email</label>@Html.TextBoxFor(m=>m.Email,new{@class="form-control",type="email"})</div><div class="col-md-6"><label>Phone</label>@Html.TextBoxFor(m=>m.Phone,new{@class="form-control"})</div><div class="col-md-6"><label>Address</label>@Html.TextBoxFor(m=>m.AddressLine1,new{@class="form-control"})</div><div class="col-md-4"><label>City</label>@Html.TextBoxFor(m=>m.City,new{@class="form-control"})</div><div class="col-md-4"><label>State / region</label>@Html.TextBoxFor(m=>m.StateOrRegion,new{@class="form-control"})</div><div class="col-md-4"><label>Postal code</label>@Html.TextBoxFor(m=>m.PostalCode,new{@class="form-control"})</div><div class="col-md-6"><label>Country</label>@Html.TextBoxFor(m=>m.Country,new{@class="form-control"})</div></div><button type="submit" class="of-mvc-btn mt-4">Create customer</button>}
