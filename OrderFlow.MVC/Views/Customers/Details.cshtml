@model OrderFlow.MVC.Models.Customer
@{ ViewBag.Title = Model.CompanyName; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer profile</div><h1 class="of-mvc-title">@Model.CompanyName</h1><p class="of-mvc-subtitle">@Model.ContactName · @Model.Email · <span class="of-mvc-status @Model.Status">@Model.Status</span></p></div><a class="of-mvc-btn" href="@Url.Action("Edit",new{id=Model.CustomerId})">Edit profile</a></div><div class="of-mvc-grid"><section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Order history</h2><p>@Model.Orders.Count recorded orders.</p></div></div><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Order</th><th>Status</th><th>Value</th><th>Created</th></tr></thead><tbody>@foreach(var order in Model.Orders.OrderByDescending(o=>o.CreatedAtUtc)){<tr><td class="of-mvc-mono"><a href="@Url.Action("Details","Orders",new{id=order.OrderId},null)">@order.OrderNumber</a></td><td><span class="of-mvc-status @order.Status">@order.Status</span></td><td class="of-mvc-mono">@order.TotalAmount.ToString("C0")</td><td>@order.CreatedAtUtc.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></section><aside class="of-mvc-card p-4"><div class="of-mvc-kicker">Contact record</div><div class="mt-3"><strong>@Model.ContactName</strong><div class="small text-muted">@Model.Email</div><div class="small text-muted">@Model.Phone</div></div><hr/><div class="small"><strong>Address</strong><br/>@Model.AddressLine1<br/>@Model.City, @Model.StateOrRegion @Model.PostalCode<br/>@Model.Country</div></aside></div>
