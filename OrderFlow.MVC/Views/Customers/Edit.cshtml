@model OrderFlow.MVC.Models.Customer
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Edit " + Model.CompanyName; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer management</div><h1 class="of-mvc-title">Edit @Model.CompanyName</h1><p class="of-mvc-subtitle">Changes are applied to the account profile while preserving its connected order history.</p></div></div>
@using(Html.BeginForm("Edit","Customers",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.CustomerId)@Html.ValidationSummary(true,"",new{@class="text-danger small"})<div class="row g-3"><div class="col-md-7"><label>Company name</label>@Html.TextBoxFor(m=>m.CompanyName,new{@class="form-control"})</div><div class="col-md-5"><label>Account status</label>@Html.EnumDropDownListFor(m=>m.Status,new{@class="form-select"})</div><div class="col-md-6"><label>Primary contact</label>@Html.TextBoxFor(m=>m.ContactName,new{@class="form-control"})</div><div class="col-md-6"><label>Email</label>@Html.TextBoxFor(m=>m.Email,new{@class="form-control"})</div><div class="col-md-6"><label>Phone</label>@Html.TextBoxFor(m=>m.Phone,new{@class="form-control"})</div><div class="col-md-6"><label>Address</label>@Html.TextBoxFor(m=>m.AddressLine1,new{@class="form-control"})</div><div class="col-md-4"><label>City</label>@Html.TextBoxFor(m=>m.City,new{@class="form-control"})</div><div class="col-md-4"><label>State / region</label>@Html.TextBoxFor(m=>m.StateOrRegion,new{@class="form-control"})</div><div class="col-md-4"><label>Postal code</label>@Html.TextBoxFor(m=>m.PostalCode,new{@class="form-control"})</div><div class="col-md-6"><label>Country</label>@Html.TextBoxFor(m=>m.Country,new{@class="form-control"})</div></div><button type="submit" class="of-mvc-btn mt-4">Save changes</button> <a class="ms-3 small" href="@Url.Action("Details",new{id=Model.CustomerId})">Cancel</a>}
