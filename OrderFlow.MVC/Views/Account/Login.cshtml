@model OrderFlow.MVC.ViewModels.LoginViewModel
@{ Layout = null; ViewBag.Title = "Sign in"; }
<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width"/><title>Sign in · OrderFlow</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="@Url.Content("~/Content/site.css")" rel="stylesheet"/></head><body class="of-mvc-login"><main class="of-mvc-login-card"><div class="of-mvc-login-brand"><img src="/manus-storage/orderflow-logo_82786c65.png" alt="OrderFlow"/>order<span style="color:#2563eb">flow</span></div><div class="of-mvc-kicker">Secure operations access</div><h1>Sign in to your ledger.</h1><p>Use a role-specific account to access the appropriate operational workspace.</p>@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "of-mvc-form mt-4" })) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.ReturnUrl) @Html.ValidationSummary(true, "", new { @class = "text-danger small" }) <div class="mb-3">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class="form-control", autocomplete="email" })@Html.ValidationMessageFor(m=>m.Email,"",new{@class="text-danger small"})</div><div class="mb-3">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { @class="form-control", autocomplete="current-password" })@Html.ValidationMessageFor(m=>m.Password,"",new{@class="text-danger small"})</div><div class="form-check mb-4">@Html.CheckBoxFor(m=>m.RememberMe,new{@class="form-check-input"})@Html.LabelFor(m=>m.RememberMe,new{@class="form-check-label small"})</div><button class="of-mvc-btn w-100" type="submit">Sign in</button> }<p class="mt-4 mb-0"><strong>Development accounts:</strong> admin@orderflow.local, sales@orderflow.local, inventory@orderflow.local, ava@northstar.example. Password: ChangeMe!123</p></main></body></html>
