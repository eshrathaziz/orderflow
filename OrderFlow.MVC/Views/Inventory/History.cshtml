@model IEnumerable<OrderFlow.MVC.Models.InventoryTransaction>
@{ ViewBag.Title = "Inventory history"; var product = ViewBag.Product as OrderFlow.MVC.Models.Product; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Inventory audit</div><h1 class="of-mvc-title">@product.Name</h1><p class="of-mvc-subtitle">@product.Sku · Every transaction retains its before/after balance and actor.</p></div><a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to inventory</a></div><section class="of-mvc-card"><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Timestamp</th><th>Type</th><th>Change</th><th>Before</th><th>After</th><th>Performed by</th><th>Notes</th></tr></thead><tbody>@foreach(var t in Model){<tr><td class="of-mvc-mono">@t.CreatedAtUtc.ToString("dd MMM HH:mm")</td><td>@t.Type</td><td class="of-mvc-mono">@t.QuantityDelta</td><td class="of-mvc-mono">@t.QuantityBefore</td><td class="of-mvc-mono">@t.QuantityAfter</td><td>@(t.PerformedBy?.DisplayName ?? "System")</td><td>@t.Notes</td></tr>}</tbody></table></div></section>
