@model IEnumerable<OrderFlow.MVC.Models.Inventory>
@{ ViewBag.Title = "Inventory"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Inventory management</div><h1 class="of-mvc-title">Stock that tells you what to do.</h1><p class="of-mvc-subtitle">Available quantity is on-hand stock less active order reservations.</p></div><button class="of-mvc-btn" onclick="alert('Use an inventory line to post an adjustment.')">Post adjustment</button></div><section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Availability ledger</h2><p>@ViewBag.Total product inventory records.</p></div><div class="of-mvc-mono text-primary">Live balance</div></div><form class="of-mvc-toolbar" method="get"><input class="form-control" name="search" value="@Request["search"]" placeholder="Search SKU or product"/><label class="small"><input type="checkbox" name="lowStock" value="true" @(ViewBag.LowStock ? "checked" : "")/> Low stock only</label><button class="of-mvc-btn ghost" type="submit">Apply</button></form><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Product</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Reorder level</th><th></th></tr></thead><tbody>@foreach(var item in Model){ var low=item.AvailableQuantity <= item.Product.ReorderLevel;<tr><td><div class="of-mvc-primary">@item.Product.Name</div><div class="of-mvc-mono text-muted mt-1">@item.Product.Sku · @item.Product.Category.Name</div></td><td class="of-mvc-mono">@item.QuantityOnHand</td><td class="of-mvc-mono">@item.ReservedQuantity</td><td class="of-mvc-mono @(low?"text-danger":"")">@item.AvailableQuantity</td><td class="of-mvc-mono">@item.Product.ReorderLevel</td><td><button class="of-mvc-btn ghost" data-adjust-inventory data-product-id="@item.ProductId">Adjust</button><a class="ms-2 small" href="@Url.Action("History",new{productId=item.ProductId})">History</a></td></tr>}</tbody></table></div></section>
