@model OrderFlow.MVC.ViewModels.DashboardViewModel
@{ ViewBag.Title = "Operations ledger"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Operations / @DateTime.UtcNow.ToString("dd MMM yyyy")</div><h1 class="of-mvc-title">Keep every order moving.</h1><p class="of-mvc-subtitle">The dashboard combines customers, products, fulfilment, inventory risk and revenue signals.</p></div><a class="of-mvc-btn" href="@Url.Action("Create", "Orders")">Create order</a></div>
<section class="of-mvc-metrics"><div class="of-mvc-metric"><label>Active customers</label><strong>@Model.TotalCustomers</strong><small>Current customer base</small></div><div class="of-mvc-metric"><label>Open orders</label><strong>@Model.PendingOrders</strong><small>Created through processing</small></div><div class="of-mvc-metric"><label>Completed orders</label><strong>@Model.CompletedOrders</strong><small>Closed fulfilment cycle</small></div><div class="of-mvc-metric"><label>Low-stock SKUs</label><strong>@Model.LowStockProducts</strong><small>Reorder action needed</small></div><div class="of-mvc-metric"><label>Month revenue</label><strong>@Model.MonthRevenue.ToString("C0")</strong><small>Delivered and completed</small></div></section>
<section class="of-mvc-grid"><article class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Recent order activity</h2><p>Order status and value in one operational view.</p></div><a href="@Url.Action("Index","Orders")" class="of-mvc-btn ghost">Open ledger</a></div><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Order</th><th>Customer</th><th>Value</th><th>Status</th></tr></thead><tbody>@foreach(var order in Model.RecentOrders){<tr><td class="of-mvc-mono of-mvc-primary">@order.OrderNumber</td><td class="of-mvc-primary">@order.CustomerName</td><td class="of-mvc-mono">@order.TotalAmount.ToString("C0")</td><td><span class="of-mvc-status @order.Status">@order.Status</span></td></tr>}</tbody></table></div></article><aside class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Stock watch</h2><p>Available balance at threshold.</p></div></div><ul class="of-mvc-list">@foreach(var item in Model.LowStockItems){<li><div><strong class="of-mvc-primary">@item.ProductName</strong><div class="of-mvc-mono text-muted mt-1">@item.Sku</div></div><div class="text-end"><strong class="text-danger of-mvc-mono">@item.AvailableQuantity available</strong><div class="small text-muted">Reorder at @item.ReorderLevel</div></div></li>}</ul></aside></section>
