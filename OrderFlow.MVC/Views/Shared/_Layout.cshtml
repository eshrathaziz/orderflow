@{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title · OrderFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    @Styles.Render("~/Content/css")
</head>
<body class="of-mvc-body">
    <div class="of-mvc-shell">
        <aside class="of-mvc-sidebar">
            <a class="of-mvc-brand" href="@Url.Action("Index", "Dashboard")"><img src="/manus-storage/orderflow-logo_82786c65.png" alt="OrderFlow" /><span>order<span>flow</span></span></a>
            <div class="of-mvc-nav-label">Workspace</div>
            <nav class="nav flex-column of-mvc-nav">
                <a class="@(controller == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")">Overview</a>
                <a class="@(controller == "Orders" ? "active" : "")" href="@Url.Action("Index", "Orders")">Orders</a>
                @if (User.IsInRole("Admin") || User.IsInRole("InventoryManager")) { <a class="@(controller == "Inventory" ? "active" : "")" href="@Url.Action("Index", "Inventory")">Inventory</a><a class="@(controller == "Products" ? "active" : "")" href="@Url.Action("Index", "Products")">Products</a> }
                @if (User.IsInRole("Admin") || User.IsInRole("SalesExecutive")) { <a class="@(controller == "Customers" ? "active" : "")" href="@Url.Action("Index", "Customers")">Customers</a> }
                <a class="@(controller == "CustomerRequests" ? "active" : "")" href="@Url.Action("Index", "CustomerRequests")">Requests</a>
            </nav>
            <div class="of-mvc-side-footer">Role: <strong>@(User.Identity.IsAuthenticated ? (User as OrderFlow.MVC.Security.CustomPrincipal)?.Role : "Guest")</strong></div>
        </aside>
        <main class="of-mvc-main">
            <header class="of-mvc-topbar"><div class="of-mvc-crumb">OrderFlow / <strong>@ViewBag.Title</strong></div><div class="of-mvc-user">@if (User.Identity.IsAuthenticated) { <span>@((User as OrderFlow.MVC.Security.CustomPrincipal)?.DisplayName)</span><form action="@Url.Action("Logout", "Account")" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit">Sign out</button></form> }</div></header>
            <div class="of-mvc-content">
                @if (TempData["Success"] != null) { <div class="alert alert-success of-mvc-alert">@TempData["Success"]</div> }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @Scripts.Render("~/bundles/orderflow")
    @RenderSection("scripts", required: false)
</body>
</html>
