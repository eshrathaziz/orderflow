@model OrderFlow.MVC.Models.Product
@{ ViewBag.Title = Model.Name; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Product record</div><h1 class="of-mvc-title">@Model.Name</h1><p class="of-mvc-subtitle">@Model.Sku · @Model.Category.Name · <span class="of-mvc-status @Model.Status">@Model.Status</span></p></div><a class="of-mvc-btn" href="@Url.Action("Edit",new{id=Model.ProductId})">Edit product</a></div><div class="of-mvc-grid"><section class="of-mvc-card p-4"><div class="of-mvc-kicker">Description</div><p class="mt-3">@(String.IsNullOrWhiteSpace(Model.Description) ? "No product description recorded." : Model.Description)</p><hr/><div class="row"><div class="col-sm-4"><div class="of-mvc-kicker">Unit price</div><strong class="d-block mt-2 of-mvc-mono">@Model.UnitPrice.ToString("C0")</strong></div><div class="col-sm-4"><div class="of-mvc-kicker">Category</div><strong class="d-block mt-2">@Model.Category.Name</strong></div><div class="col-sm-4"><div class="of-mvc-kicker">Reorder level</div><strong class="d-block mt-2 of-mvc-mono">@Model.ReorderLevel units</strong></div></div></section><aside class="of-mvc-card p-4"><div class="of-mvc-kicker">Availability</div><div class="mt-3"><strong class="display-6">@(Model.Inventory?.AvailableQuantity ?? 0)</strong><div class="small text-muted">Available for new reservations</div></div><hr/><div class="small">On hand: <strong>@(Model.Inventory?.QuantityOnHand ?? 0)</strong></div><div class="small mt-2">Reserved: <strong>@(Model.Inventory?.ReservedQuantity ?? 0)</strong></div><a class="of-mvc-btn ghost mt-4" href="@Url.Action("History","Inventory",new{productId=Model.ProductId},null)">Open transaction history</a></aside></div>
