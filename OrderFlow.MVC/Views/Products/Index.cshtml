@model IEnumerable<OrderFlow.MVC.Models.Product>
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Products"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Product management</div><h1 class="of-mvc-title">Product catalogue</h1><p class="of-mvc-subtitle">Commercial SKU data, availability threshold and active sales status in one controlled record.</p></div><a class="of-mvc-btn" href="@Url.Action("Create")">New product</a></div>
<section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Active product set</h2><p>@ViewBag.Total product records found.</p></div></div><form class="of-mvc-toolbar" method="get"><input class="form-control" name="search" value="@Request["search"]" placeholder="Product name or SKU"/><select class="form-select" name="categoryId"><option value="">All categories</option>@foreach(var category in (IEnumerable<Category>)ViewBag.Categories){<option value="@category.CategoryId">@category.Name</option>}</select><button class="of-mvc-btn ghost" type="submit">Apply filters</button></form><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Unit price</th><th>Available</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var product in Model){<tr><td class="of-mvc-primary of-mvc-mono">@product.Sku</td><td class="of-mvc-primary"><a href="@Url.Action("Details",new{id=product.ProductId})">@product.Name</a></td><td>@product.Category.Name</td><td class="of-mvc-mono">@product.UnitPrice.ToString("C0")</td><td class="of-mvc-mono">@(product.Inventory?.AvailableQuantity ?? 0)</td><td><span class="of-mvc-status @product.Status">@product.Status</span></td><td><a class="of-mvc-btn ghost" href="@Url.Action("Edit",new{id=product.ProductId})">Edit</a></td></tr>}</tbody></table></div></section>
