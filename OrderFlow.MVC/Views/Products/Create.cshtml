@model OrderFlow.MVC.Models.Product
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "New product"; var categories = ViewBag.Categories as IEnumerable<Category>; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Product management</div><h1 class="of-mvc-title">Create a product record.</h1><p class="of-mvc-subtitle">Each product is given one inventory balance, a reorder threshold and an active sales status.</p></div><a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to catalogue</a></div>@using(Html.BeginForm("Create","Products",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new{@class="text-danger small"})<div class="row g-3"><div class="col-md-6"><label>SKU</label>@Html.TextBoxFor(m=>m.Sku,new{@class="form-control"})</div><div class="col-md-6"><label>Category</label><select class="form-select" name="CategoryId">@foreach(var c in categories){<option value="@c.CategoryId">@c.Name</option>}</select></div><div class="col-12"><label>Product name</label>@Html.TextBoxFor(m=>m.Name,new{@class="form-control"})</div><div class="col-md-6"><label>Unit price</label>@Html.TextBoxFor(m=>m.UnitPrice,new{@class="form-control",type="number",step="0.01"})</div><div class="col-md-6"><label>Initial stock</label><input class="form-control" name="initialQuantity" type="number" min="0" value="0"/></div><div class="col-md-6"><label>Reorder level</label>@Html.TextBoxFor(m=>m.ReorderLevel,new{@class="form-control",type="number",min="0"})</div><div class="col-md-6"><label>Status</label>@Html.EnumDropDownListFor(m=>m.Status,new{@class="form-select"})</div><div class="col-12"><label>Description</label>@Html.TextAreaFor(m=>m.Description,new{@class="form-control",rows="3"})</div></div><button type="submit" class="of-mvc-btn mt-4">Create product</button>}
