@model OrderFlow.MVC.Models.Product
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Edit " + Model.Name; var categories = ViewBag.Categories as IEnumerable<Category>; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Product management</div><h1 class="of-mvc-title">Edit @Model.Sku</h1><p class="of-mvc-subtitle">Master-data changes preserve order line snapshots and current inventory balances.</p></div></div>@using(Html.BeginForm("Edit","Products",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.ProductId)@Html.ValidationSummary(true,"",new{@class="text-danger small"})<div class="row g-3"><div class="col-md-6"><label>SKU</label>@Html.TextBoxFor(m=>m.Sku,new{@class="form-control"})</div><div class="col-md-6"><label>Category</label><select class="form-select" name="CategoryId">@foreach(var c in categories){<option value="@c.CategoryId" @(c.CategoryId==Model.CategoryId?"selected":"")>@c.Name</option>}</select></div><div class="col-12"><label>Product name</label>@Html.TextBoxFor(m=>m.Name,new{@class="form-control"})</div><div class="col-md-6"><label>Unit price</label>@Html.TextBoxFor(m=>m.UnitPrice,new{@class="form-control",type="number",step="0.01"})</div><div class="col-md-6"><label>Reorder level</label>@Html.TextBoxFor(m=>m.ReorderLevel,new{@class="form-control",type="number",min="0"})</div><div class="col-md-6"><label>Status</label>@Html.EnumDropDownListFor(m=>m.Status,new{@class="form-select"})</div><div class="col-12"><label>Description</label>@Html.TextAreaFor(m=>m.Description,new{@class="form-control",rows="3"})</div></div><button type="submit" class="of-mvc-btn mt-4">Save changes</button> <a class="ms-3 small" href="@Url.Action("Details",new{id=Model.ProductId})">Cancel</a>}

