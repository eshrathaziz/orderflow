@model OrderFlow.MVC.Models.Order
@{ ViewBag.Title = "Order " + Model.OrderNumber; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Order record</div><h1 class="of-mvc-title">@Model.OrderNumber</h1><p class="of-mvc-subtitle">@Model.Customer.CompanyName · created @Model.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</p></div><div class="d-flex gap-2">@if(Model.Status == OrderFlow.MVC.Models.OrderStatus.Created){<a class="of-mvc-btn" href="@Url.Action("Edit", new { id = Model.OrderId })">Edit order</a>}<a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to ledger</a></div></div><div class="of-mvc-grid"><section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Order lines</h2><p>Commercial value and reserved fulfilment quantities.</p></div><span class="of-mvc-status @Model.Status">@Model.Status</span></div><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>SKU</th><th>Product</th><th>Qty</th><th>Unit price</th><th>Line total</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="of-mvc-mono">@item.Product.Sku</td><td class="of-mvc-primary">@item.Product.Name</td><td class="of-mvc-mono">@item.Quantity</td><td class="of-mvc-mono">@item.UnitPrice.ToString("C0")</td><td class="of-mvc-mono">@item.LineTotal.ToString("C0")</td></tr>}</tbody></table></div></section><aside class="of-mvc-card p-4"><div class="of-mvc-kicker">Order summary</div><div class="d-flex justify-content-between mt-3"><span>Subtotal</span><strong class="of-mvc-mono">@Model.Subtotal.ToString("C0")</strong></div><div class="d-flex justify-content-between mt-2"><span>Tax (@Model.TaxRate.ToString("P0"))</span><strong class="of-mvc-mono">@Model.TaxAmount.ToString("C0")</strong></div><hr/><div class="d-flex justify-content-between"><strong>Total</strong><strong class="of-mvc-mono">@Model.TotalAmount.ToString("C0")</strong></div><div class="small text-muted mt-4">Assigned sales executive: @(Model.SalesExecutive?.DisplayName ?? "Unassigned")</div></aside></div>
