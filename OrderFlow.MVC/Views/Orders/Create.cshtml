@model OrderFlow.MVC.ViewModels.OrderCreateViewModel
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Create order"; var customers = ViewBag.Customers as IEnumerable<Customer>; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Order management</div><h1 class="of-mvc-title">Build a controlled order.</h1><p class="of-mvc-subtitle">The order service validates stock, calculates tax and reserves product availability in one transaction.</p></div><a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to orders</a></div>
@using(Html.BeginForm("Create","Orders",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new{@class="text-danger small"})<div class="mb-3"><label>Customer</label><select class="form-select" name="CustomerId" required><option value="">Select active customer</option>@foreach(var c in customers){<option value="@c.CustomerId">@c.CompanyName · @c.ContactName</option>}</select></div><div class="row g-2 mb-2"><div class="col-md-8"><label>Product</label><input id="of-product-search" class="form-control" placeholder="Search by product name or SKU" autocomplete="off"/><select class="form-select of-order-product mt-2" name="Items[0].ProductId" required><option value="">Select a product after search</option></select></div><div class="col-md-4"><label>Quantity</label><input class="form-control of-order-quantity" type="number" min="1" name="Items[0].Quantity" value="1" required/></div></div><div id="of-availability" class="small text-muted mb-3">Select a product to check available inventory.</div><div class="mb-3"><label>Tax rate</label><select class="form-select" id="TaxRate" name="TaxRate"><option value="0.08">8%</option><option value="0.05">5%</option><option value="0">0%</option></select></div><div class="mb-3"><label>Shipping address</label><textarea class="form-control" name="ShippingAddress" rows="2"></textarea></div><div class="mb-4"><label>Internal notes</label><textarea class="form-control" name="Notes" rows="3"></textarea></div><button class="of-mvc-btn" type="submit">Create order and reserve stock</button>}</section>
@section scripts { <script>$("#of-product-search").on("input",function(){var q=this.value;if(q.length<2)return;$.getJSON("@Url.Action("ProductSearch")",{query:q},function(rows){var s=$(".of-order-product").empty().append('<option value="">Select a product</option>');$.each(rows,function(_,p){s.append($('<option>',{value:p.ProductId,text:p.Sku+' · '+p.Name+' ('+p.Available+' available)'}));});});});</script> }
