@model IEnumerable<OrderFlow.MVC.Models.Order>
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Orders"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Order management</div><h1 class="of-mvc-title">Order ledger</h1><p class="of-mvc-subtitle">Validate availability, maintain totals and advance only through permitted fulfilment states.</p></div><a class="of-mvc-btn" href="@Url.Action("Create")">Create order</a></div>
<section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>All orders</h2><p>@ViewBag.Total orders found.</p></div><div class="of-mvc-mono text-primary">Created → Completed</div></div><form class="of-mvc-toolbar" method="get"><input class="form-control" type="search" name="search" value="@Request["search"]" placeholder="Order or customer"/><select class="form-select" name="status"><option value="">All statuses</option>@foreach(OrderStatus status in Enum.GetValues(typeof(OrderStatus))){<option value="@status" @(Request["status"] == status.ToString() ? "selected" : "")>@status</option>}</select><button class="of-mvc-btn ghost" type="submit">Apply filters</button></form><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Order</th><th>Customer</th><th>Value</th><th>Status</th><th>Placed</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td class="of-mvc-primary of-mvc-mono"><a href="@Url.Action("Details",new{id=order.OrderId})">@order.OrderNumber</a></td><td class="of-mvc-primary">@order.Customer.CompanyName</td><td class="of-mvc-mono">@order.TotalAmount.ToString("C0")</td><td><span class="of-mvc-status @order.Status">@order.Status</span></td><td>@order.CreatedAtUtc.ToString("dd MMM, HH:mm")</td><td>@if(order.Status != OrderStatus.Completed && order.Status != OrderStatus.Cancelled){ var next = (OrderStatus)((int)order.Status + 1); <button class="of-mvc-btn ghost" data-order-id="@order.OrderId" data-order-status="@next">Advance</button> }</td></tr>}</tbody></table></div><div class="px-3 py-3 small text-muted">Page @ViewBag.Page · @ViewBag.Total total records</div></section>
