@model OrderFlow.MVC.Models.CustomerRequest
@{ ViewBag.Title = "Request " + Model.RequestNumber; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer request</div><h1 class="of-mvc-title">@Model.RequestNumber</h1><p class="of-mvc-subtitle">@Model.Customer.CompanyName · @Model.Type · submitted @Model.SubmittedAtUtc.ToString("dd MMM yyyy, HH:mm")</p></div><a class="of-mvc-btn ghost" href="@Url.Action("Index")">Back to queue</a></div><div class="of-mvc-grid"><section class="of-mvc-card p-4"><div class="d-flex justify-content-between"><strong>Customer message</strong><span class="of-mvc-status @Model.Status">@Model.Status</span></div><p class="mt-3">@Model.Description</p>@if(!String.IsNullOrWhiteSpace(Model.Resolution)){<div class="alert alert-success small mt-4"><strong>Resolution:</strong> @Model.Resolution</div>}<hr/><div class="of-mvc-kicker mb-3">Communication history</div>@foreach(var h in Model.History.OrderByDescending(x=>x.CreatedAtUtc)){<div class="border-bottom py-3"><strong class="small">@(h.Author?.DisplayName ?? "System")</strong><span class="text-muted small ms-2">@h.CreatedAtUtc.ToString("dd MMM HH:mm")</span><p class="mb-0 mt-1 small">@h.Message</p></div>}</section><aside class="of-mvc-card p-4"><div class="of-mvc-kicker">Request routing</div><div class="mt-3 small">Priority: <strong>@Model.Priority</strong></div><div class="mt-2 small">Assigned: <strong>@(Model.AssignedEmployee?.DisplayName ?? "Unassigned")</strong></div><div class="mt-2 small">Order: <strong>@(Model.Order?.OrderNumber ?? "Not linked")</strong></div></aside></div>

