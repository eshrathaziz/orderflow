@model IEnumerable<OrderFlow.MVC.Models.CustomerRequest>
@{ ViewBag.Title = "Customer requests"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer service</div><h1 class="of-mvc-title">Requests that stay accountable.</h1><p class="of-mvc-subtitle">Customer changes, priorities, ownership, resolution and communication remain connected to the related order.</p></div><a class="of-mvc-btn" href="@Url.Action("Create")">Log request</a></div><section class="of-mvc-card"><div class="of-mvc-card-head"><div><h2>Service queue</h2><p>Requests ordered by priority and submission time.</p></div></div><div class="table-responsive"><table class="table of-mvc-table"><thead><tr><th>Request</th><th>Customer</th><th>Order</th><th>Priority</th><th>Status</th><th>Assigned</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><a class="of-mvc-primary of-mvc-mono" href="@Url.Action("Details",new{id=r.CustomerRequestId})">@r.RequestNumber</a><div class="small text-muted mt-1">@r.Type</div></td><td>@r.Customer.CompanyName</td><td class="of-mvc-mono">@(r.Order?.OrderNumber ?? "—")</td><td><span class="of-mvc-status @(r.Priority.ToString()=="Urgent"||r.Priority.ToString()=="High"?"low":"")">@r.Priority</span></td><td><span class="of-mvc-status @r.Status">@r.Status</span></td><td>@(r.AssignedEmployee?.DisplayName ?? "Unassigned")</td><td><a class="of-mvc-btn ghost" href="@Url.Action("Details",new{id=r.CustomerRequestId})">Open</a></td></tr>}</tbody></table></div></section>
