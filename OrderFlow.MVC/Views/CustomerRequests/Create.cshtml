@model OrderFlow.MVC.ViewModels.CustomerRequestCreateViewModel
@using OrderFlow.MVC.Models
@{ ViewBag.Title = "Log request"; }
<div class="of-mvc-head"><div><div class="of-mvc-kicker">Customer service</div><h1 class="of-mvc-title">Capture a customer request.</h1><p class="of-mvc-subtitle">Requests are assigned a traceable number and begin with an auditable communication event.</p></div></div>@using(Html.BeginForm("Create","CustomerRequests",FormMethod.Post,new{@class="of-mvc-form of-mvc-card p-4"})){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new{@class="text-danger small"})@Html.HiddenFor(m=>m.CustomerId)<div class="mb-3"><label>Linked order (optional)</label>@Html.TextBoxFor(m=>m.OrderId,new{@class="form-control",type="number"})</div><div class="mb-3"><label>Request type</label>@Html.EnumDropDownListFor(m=>m.Type,new{@class="form-select"})</div><div class="mb-3"><label>Priority</label>@Html.EnumDropDownListFor(m=>m.Priority,new{@class="form-select"})</div><div class="mb-4"><label>Description</label>@Html.TextAreaFor(m=>m.Description,new{@class="form-control",rows="5"})</div><button type="submit" class="of-mvc-btn">Submit request</button>}
